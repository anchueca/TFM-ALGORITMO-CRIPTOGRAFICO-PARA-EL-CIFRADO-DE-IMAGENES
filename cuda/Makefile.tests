# Test Makefile for comprehensive unit tests
# This makefile builds and runs the comprehensive unit test suite

# Configuration
TEST_NAME = test_unit_comprehensive
TEST_SRC = test/$(TEST_NAME).cu
TEST_BIN = test/$(TEST_NAME).out

# Compiler settings
NVCC = nvcc
NVCC_FLAGS = -std=c++17 -rdc=true -O2 -G -g
NVCC_ARCH = -arch=sm_89

# Library paths and flags
OPENCV_LIBS = $(shell pkg-config --libs opencv4)
OPENCV_CFLAGS = $(shell pkg-config --cflags opencv4)
CUDA_LIBS = -lcudart -lcurand

# Google Test flags
GTEST_FLAGS = -lgtest -lgtest_main -lpthread

# Include paths
INCLUDE_PATHS = -I./include -I./src
OPENCV_INCLUDE = $(OPENCV_CFLAGS)

# Linking settings
CCBIN = -ccbin g++
LDFLAGS = $(CUDA_LIBS) $(OPENCV_LIBS) $(GTEST_FLAGS) -lssl -lcrypto

# Source files from main library (excluding main.cu and aux.cu)
# NOTE: aux.cu excluded because it contains steganography functions with undefined references
CUDA_SOURCES = \
	src/automata.cu \
	src/automataKernel.cu \
	src/cli_helpers.cu \
	src/CudaPermutation.cu \
	src/encryption_aux.cu \
	src/encryption.cu \
	src/kernels_aux.cu \
	src/kernels.cu

# Default target
all: $(TEST_BIN)

# Build test executable (compile everything together)
$(TEST_BIN): $(TEST_SRC) $(CUDA_SOURCES)
	@echo "Compiling and linking test executable..."
	$(NVCC) $(NVCC_FLAGS) $(NVCC_ARCH) $(CCBIN) \
		$(INCLUDE_PATHS) $(OPENCV_INCLUDE) \
		$(TEST_SRC) $(CUDA_SOURCES) \
		$(LDFLAGS) -o $(TEST_BIN)
	@echo "Build complete: $(TEST_BIN)"

# Run tests
run: $(TEST_BIN)
	@echo "Running comprehensive unit tests..."
	./$(TEST_BIN)

# Run with verbose output
run-verbose: $(TEST_BIN)
	@echo "Running comprehensive unit tests (verbose)..."
	./$(TEST_BIN) --gtest_print_time=1 --gtest_print_utf8=1

# Run specific test pattern
run-filter: $(TEST_BIN)
	@echo "Usage: make run-filter FILTER=<pattern>"
	./$(TEST_BIN) --gtest_filter=$(FILTER)

# List all tests
list-tests: $(TEST_BIN)
	./$(TEST_BIN) --gtest_list_tests

# Clean test artifacts
clean-tests:
	rm -f test/*.o $(TEST_BIN)

# Full clean
clean: clean-tests
	rm -f test/*.o

.PHONY: all run run-verbose run-filter list-tests clean-tests clean
