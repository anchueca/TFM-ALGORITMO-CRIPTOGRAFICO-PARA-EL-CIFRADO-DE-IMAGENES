# Makefile for Visual Demo Program
# Compiles and runs visual demonstrations of cellular automata and encryption phases

# Configuration
DEMO_NAME = visual_demo
DEMO_SRC = test/$(DEMO_NAME).cu
DEMO_BIN = test/$(DEMO_NAME).out

# Compiler settings
NVCC = nvcc
NVCC_FLAGS = -std=c++17 -rdc=true -O2
NVCC_ARCH = -arch=sm_70

# Library paths and flags
OPENCV_LIBS = $(shell pkg-config --libs opencv4)
OPENCV_CFLAGS = $(shell pkg-config --cflags opencv4)
CUDA_LIBS = -lcudart

# Include paths
INCLUDE_PATHS = -I./include -I./src
OPENCV_INCLUDE = $(OPENCV_CFLAGS)

# Linking settings
CCBIN = -ccbin g++-12
LDFLAGS = $(CUDA_LIBS) $(OPENCV_LIBS) -lssl -lcrypto

# Source files from main library (excluding main.cu and aux.cu)
CUDA_SOURCES = \
	src/automata.cu \
	src/automataKernel.cu \
	src/cli_helpers.cu \
	src/CudaPermutation.cu \
	src/encryption_aux.cu \
	src/encryption.cu \
	src/kernels_aux.cu \
	src/kernels.cu

# Default target
all: $(DEMO_BIN)

# Build visual demo executable
$(DEMO_BIN): $(DEMO_SRC) $(CUDA_SOURCES)
	@echo "Compiling visual demo..."
	$(NVCC) $(NVCC_FLAGS) $(NVCC_ARCH) $(CCBIN) \
		$(INCLUDE_PATHS) $(OPENCV_INCLUDE) \
		$(DEMO_SRC) $(CUDA_SOURCES) \
		$(LDFLAGS) -o $(DEMO_BIN)
	@echo "✓ Build complete: $(DEMO_BIN)"

# Run visual demo
run: $(DEMO_BIN)
	@echo "Starting visual demonstrations..."
	@echo "Note: Press any key in window prompts to continue"
	./$(DEMO_BIN)

# Clean build artifacts
clean:
	@echo "Cleaning visual demo build..."
	rm -f test/$(DEMO_NAME).o
	rm -f $(DEMO_BIN)
	@echo "✓ Clean complete"

.PHONY: all run clean
